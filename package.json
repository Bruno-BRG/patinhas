{
	"name": "financas",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler pages dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:migrate:local": "wrangler d1 migrations apply financas --local",
		"db:migrate:remote": "wrangler d1 migrations apply financas --remote",
		"typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261019.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.0",
		"vite": "^8.3.4",
		"wrangler": "^4.151.2"
	}
}
